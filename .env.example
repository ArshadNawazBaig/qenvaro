# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=qenvaro
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPER_ADMIN_EMAILS=
# Optional; enables credential login for deterministic development seed users only.
DEVELOPMENT_SEED_PASSWORD=

# Email: "smtp" for local Mailpit, "log" for redacted diagnostics, or "resend" for production
EMAIL_PROVIDER=smtp
EMAIL_FROM=Qenvaro <hello@example.com>
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# SaaS billing (organization-level subscriptions only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
ALLOW_DEV_BILLING_BYPASS=false

# Object storage: "filesystem" for local development or "s3" for production
STORAGE_PROVIDER=filesystem
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_ASSET_URL=

# Product image storage (server-only Cloudinary credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
